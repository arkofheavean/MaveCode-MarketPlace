{
  "id": "axiom",
  "name": "Axiom",
  "description": "Query and analyze data using Axiom Processing Language (APL), enabling AI agents to interact with Axiom datasets through natural language.",
  "author": "axiomhq",
  "url": "https://github.com/axiomhq/mcp-server-axiom",
  "tags": [
    "data-query",
    "log-analysis",
    "apl",
    "datasets",
    "analytics"
  ],
  "content": [
    {
      "name": "Go Binary",
      "content": "{\n  \"command\": \"{{AXIOM_BINARY_PATH}}/axiom-mcp\",\n  \"args\": [\"--config\", \"{{AXIOM_CONFIG_PATH}}\"]\n}\n",
      "parameters": [
        {
          "name": "Axiom Config Path",
          "key": "AXIOM_CONFIG_PATH",
          "placeholder": "/path/to/config.txt"
        }
      ]
    },
    {
      "name": "Go Binary with Environment Variables",
      "content": "{\n  \"command\": \"{{AXIOM_BINARY_PATH}}/axiom-mcp\",\n  \"env\": {\n    \"AXIOM_TOKEN\": \"{{AXIOM_TOKEN}}\",\n    \"AXIOM_URL\": \"{{AXIOM_URL}}\",\n    \"AXIOM_ORG_ID\": \"{{AXIOM_ORG_ID}}\"\n  }\n}\n"
    },
    {
      "name": "Go Binary with Command Line Flags",
      "content": "{\n  \"command\": \"{{AXIOM_BINARY_PATH}}/axiom-mcp\",\n  \"args\": [\n    \"-token\", \"{{AXIOM_TOKEN}}\",\n    \"-url\", \"{{AXIOM_URL}}\",\n    \"-query-rate\", \"1\",\n    \"-query-burst\", \"1\",\n    \"-datasets-rate\", \"1\",\n    \"-datasets-burst\", \"1\"\n  ]\n}\n"
    }
  ],
  "parameters": [
    {
      "name": "Axiom Binary Path",
      "key": "AXIOM_BINARY_PATH",
      "placeholder": "/path/to/axiom-mcp"
    },
    {
      "name": "Axiom Token",
      "key": "AXIOM_TOKEN",
      "placeholder": "xaat-your-token"
    },
    {
      "name": "Axiom URL",
      "key": "AXIOM_URL",
      "placeholder": "https://api.axiom.co"
    },
    {
      "name": "Axiom Org ID",
      "key": "AXIOM_ORG_ID",
      "placeholder": "your-org-id",
      "optional": true
    }
  ],
  "type": "mcp",
  "version": "1.0.0",
  "updatedAt": "2026-08-31T00:00:00.000Z"
}
