{
  "id": "postgres",
  "name": "PostgreSQL Reader",
  "description": "Provides read-only access to PostgreSQL databases, allowing LLMs to inspect database schemas and execute read-only queries within protected transactions.",
  "author": "modelcontextprotocol",
  "url": "https://github.com/modelcontextprotocol/servers-archived/tree/main/src/postgres",
  "tags": [
    "postgresql",
    "database-queries",
    "schema-inspection",
    "read-only",
    "sql"
  ],
  "content": [
    {
      "name": "NPX",
      "prerequisites": [
        "Node.js"
      ],
      "content": "{\n  \"command\": \"npx\",\n  \"args\": [\"-y\", \"@modelcontextprotocol/server-postgres\", \"{{POSTGRESQL_URL}}\"]\n}\n"
    },
    {
      "name": "Docker",
      "prerequisites": [
        "Docker"
      ],
      "content": "{\n  \"command\": \"docker\",\n  \"args\": [\"run\", \"-i\", \"--rm\", \"mcp/postgres\", \"{{POSTGRESQL_URL}}\"]\n}\n"
    }
  ],
  "parameters": [
    {
      "name": "PostgreSQL URL",
      "key": "POSTGRESQL_URL",
      "placeholder": "postgresql://user:password@localhost:5432/mydb"
    }
  ],
  "type": "mcp",
  "version": "1.0.0",
  "updatedAt": "2026-08-31T00:00:00.000Z"
}
