  "content": [
    {
      "name": "Go Binary",
      "content": "{\n  \"command\": \"{{METORO_BINARY_PATH}}/metoro-mcp-server\",\n  \"args\": [],\n  \"env\": {\n    \"METORO_AUTH_TOKEN\": \"{{METORO_AUTH_TOKEN}}\",\n    \"METORO_API_URL\": \"{{METORO_API_URL}}\"\n  }\n}\n"
    },
    {
      "name": "Demo Cluster",
      "content": "{\n  \"command\": \"{{METORO_BINARY_PATH}}/metoro-mcp-server\",\n  \"args\": [],\n  \"env\": {\n    \"METORO_AUTH_TOKEN\": \"{{METORO_AUTH_TOKEN}}\",\n    \"METORO_API_URL\": \"{{METORO_API_URL}}\"\n  }\n}\n"
    }
  ],
  "parameters": [
    {
      "name": "Metoro Binary Path",
      "key": "METORO_BINARY_PATH",
      "placeholder": "/path/to/metoro-mcp-server"
    },
    {
      "name": "Metoro Auth Token",
      "key": "METORO_AUTH_TOKEN",
      "placeholder": "your_metoro_auth_token"
    },
    {
      "name": "Metoro API URL",
      "key": "METORO_API_URL",
      "placeholder": "https://us-east.metoro.io"
