{
  "id": "google-workspace",
  "name": "Google Workspace",
  "description": "Control Gmail, Google Calendar, Docs, Sheets, Slides, Chat, Forms, Tasks, Search & Drive with AI. The most feature-complete Google Workspace / G Suite MCP server.",
