{
  "id": "google-maps",
  "name": "Google Maps",
  "description": "Provides comprehensive access to Google Maps services including geocoding, place search, directions, distance calculations, and elevation data through the Google Maps API.",
  "author": "modelcontextprotocol",
  "url": "https://github.com/modelcontextprotocol/servers/tree/main/src/google-maps",
  "tags": [
    "maps",
    "geocoding",
    "navigation",
    "places-api",
    "location-data"
  ],
  "prerequisites": [
    "Google Cloud account with Maps API enabled"
  ],
  "content": [
    {
      "name": "UVX",
      "prerequisites": [
        "Python and uv"
      ],
      "content": "{\n  \"command\": \"uvx\",\n  \"args\": [\"mcp-server-google-maps\"],\n  \"env\": {\n    \"GOOGLE_MAPS_API_KEY\": \"{{GOOGLE_MAPS_API_KEY}}\"\n  }\n}\n"
    },
    {
      "name": "Python/Pip",
      "prerequisites": [
        "Python"
      ],
      "content": "{\n  \"command\": \"python\",\n  \"args\": [\"-m\", \"mcp_server_google_maps\"],\n  \"env\": {\n    \"GOOGLE_MAPS_API_KEY\": \"{{GOOGLE_MAPS_API_KEY}}\"\n  }\n}\n"
    },
    {
      "name": "Docker",
      "prerequisites": [
        "Docker"
      ],
      "content": "{\n  \"command\": \"docker\",\n  \"args\": [\"run\", \"-i\", \"--rm\", \"mcp/google-maps\"],\n  \"env\": {\n    \"GOOGLE_MAPS_API_KEY\": \"{{GOOGLE_MAPS_API_KEY}}\"\n  }\n}\n"
    }
  ],
  "parameters": [
    {
      "name": "Google Maps API Key",
      "key": "GOOGLE_MAPS_API_KEY",
      "placeholder": "your_google_maps_api_key"
    }
  ],
  "type": "mcp",
  "version": "1.0.0",
  "updatedAt": "2026-08-31T00:00:00.000Z"
}
