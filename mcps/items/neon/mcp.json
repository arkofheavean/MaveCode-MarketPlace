{
  "id": "neon",
  "name": "Neon Database",
  "description": "Enables natural language interaction with Neon PostgreSQL databases, supporting project management, schema migrations, SQL queries, and database operations through the Neon API.",
  "author": "neondatabase",
  "url": "https://github.com/neondatabase/mcp-server-neon",
  "tags": [
    "postgresql",
    "database-management",
    "migrations",
    "sql",
    "neon-api"
  ],
  "content": [
    {
      "name": "Remote MCP",
      "prerequisites": [
        "Node.js"
      ],
      "content": "{\n  \"command\": \"npx\",\n  \"args\": [\"-y\", \"mcp-remote\", \"https://mcp.neon.tech/sse\"]\n}\n"
    },
    {
      "name": "NPX with API Key",
      "prerequisites": [
        "Node.js"
      ],
      "content": "{\n  \"command\": \"npx\",\n  \"args\": [\"-y\", \"@neondatabase/mcp-server-neon\", \"start\", \"{{NEON_API_KEY}}\"]\n}\n"
    },
    {
      "name": "Smithery Installation",
      "prerequisites": [
        "Node.js"
      ],
      "content": "{\n  \"command\": \"npx\",\n  \"args\": [\"-y\", \"@smithery/cli\", \"install\", \"neon\", \"--client\", \"claude\"]\n}\n"
    },
    {
      "name": "Windows CMD",
      "prerequisites": [
        "Node.js"
      ],
      "content": "{\n  \"command\": \"cmd\",\n  \"args\": [\"/c\", \"npx\", \"-y\", \"@neondatabase/mcp-server-neon\", \"start\", \"{{NEON_API_KEY}}\"]\n}\n"
    },
    {
      "name": "Windows WSL",
      "prerequisites": [
        "Node.js"
      ],
      "content": "{\n  \"command\": \"wsl\",\n  \"args\": [\"npx\", \"-y\", \"@neondatabase/mcp-server-neon\", \"start\", \"{{NEON_API_KEY}}\"]\n}\n"
    }
  ],
  "parameters": [
    {
      "name": "Neon API Key",
      "key": "NEON_API_KEY",
      "placeholder": "your_neon_api_key",
      "optional": true
    }
  ],
  "type": "mcp",
  "version": "1.0.0",
  "updatedAt": "2026-08-31T00:00:00.000Z"
}
