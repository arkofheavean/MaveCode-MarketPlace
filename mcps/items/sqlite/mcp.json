  "content": [
    {
      "name": "UVX",
      "prerequisites": [
        "Python and uv"
      ],
      "content": "{\n  \"command\": \"uvx\",\n  \"args\": [\"mcp-server-sqlite\", \"--db-path\", \"{{DB_PATH}}\"]\n}\n"
    },
    {
      "name": "Docker",
      "prerequisites": [
        "Docker"
      ],
      "content": "{\n  \"command\": \"docker\",\n  \"args\": [\"run\", \"--rm\", \"-i\", \"-v\", \"mcp-sqlite:/mcp\", \"mcp/sqlite\", \"--db-path\", \"{{DB_PATH}}\"]\n}\n"
    }
  ],
  "parameters": [
    {
      "name": "Database Path",
      "key": "DB_PATH",
      "placeholder": "/path/to/database.db"
    }
  ],
