{
  "id": "tavily",
  "name": "Tavily",
  "description": "Enables real-time web search and data extraction capabilities through Tavily's API, providing AI assistants with filtered search results and intelligent content extraction from web pages.",
  "author": "tavily-ai",
  "url": "https://github.com/tavily-ai/tavily-mcp",
  "tags": [
    "web-search",
    "data-extraction",
    "real-time-information",
    "content-filtering",
    "news-search"
  ],
  "prerequisites": [
    "Tavily account"
  ],
  "content": [
    {
      "name": "NPX",
      "prerequisites": [
        "Node.js"
      ],
      "content": "{\n  \"command\": \"npx\",\n  \"args\": [\"-y\", \"tavily-mcp@0.2.3\"],\n  \"env\": {\n    \"TAVILY_API_KEY\": \"{{TAVILY_API_KEY}}\"\n  }\n}\n"
    },
    {
      "name": "Docker",
      "prerequisites": [
        "Docker"
      ],
      "content": "{\n  \"command\": \"docker\",\n  \"args\": [\n    \"run\",\n    \"-i\",\n    \"--rm\",\n    \"-e\",\n    \"TAVILY_API_KEY\",\n    \"mcp/tavily\"\n  ],\n  \"env\": {\n    \"TAVILY_API_KEY\": \"{{TAVILY_API_KEY}}\"\n  }\n}\n"
    }
  ],
  "parameters": [
    {
      "name": "Tavily API Key",
      "key": "TAVILY_API_KEY",
      "placeholder": "your-tavily-apikey-here"
    }
  ],
  "type": "mcp",
  "version": "1.0.0",
  "updatedAt": "2026-08-31T00:00:00.000Z"
}
