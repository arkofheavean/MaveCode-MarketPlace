{
  "id": "brave-search",
  "name": "Brave Search",
  "description": "Integrates Brave Search API to provide comprehensive web and local search capabilities with smart filtering, pagination, and automatic fallbacks.",
  "author": "modelcontextprotocol",
  "url": "https://github.com/modelcontextprotocol/servers-archived/tree/main/src/brave-search",
  "tags": [
    "search-engine",
    "local-search",
    "web-search",
    "brave-api",
    "content-discovery"
  ],
  "prerequisites": [
    "Brave Search account"
  ],
  "content": [
    {
      "name": "NPX",
      "prerequisites": [
        "Node.js"
      ],
      "content": "{\n  \"command\": \"npx\",\n  \"args\": [\"-y\", \"@modelcontextprotocol/server-brave-search\"],\n  \"env\": {\n    \"BRAVE_API_KEY\": \"{{BRAVE_API_KEY}}\"\n  }\n}\n"
    },
    {
      "name": "Docker",
      "prerequisites": [
        "Docker"
      ],
      "content": "{\n  \"command\": \"docker\",\n  \"args\": [\"run\", \"-i\", \"--rm\", \"-e\", \"BRAVE_API_KEY\", \"mcp/brave-search\"],\n  \"env\": {\n    \"BRAVE_API_KEY\": \"{{BRAVE_API_KEY}}\"\n  }\n}\n"
    }
  ],
  "parameters": [
    {
      "name": "Brave API Key",
      "key": "BRAVE_API_KEY",
      "placeholder": "your_brave_api_key_here"
    }
  ],
  "type": "mcp",
  "version": "1.0.0",
  "updatedAt": "2026-08-31T00:00:00.000Z"
}
