{
  "id": "kagi",
  "name": "Kagi Search",
  "description": "Integrates Kagi's advanced search API to provide AI assistants with up-to-date web search capabilities and accurate information retrieval.",
  "author": "kagisearch",
  "url": "https://github.com/kagisearch/kagimcp",
  "tags": [
    "web-search",
    "information-retrieval",
    "kagi-api",
    "real-time-data",
    "search-engine"
  ],
  "prerequisites": [
    "Kagi account"
  ],
  "content": [
    {
      "name": "UVX",
      "prerequisites": [
        "Python",
        "uv"
      ],
      "content": "{\n  \"command\": \"uvx\",\n  \"args\": [\"kagimcp\"],\n  \"env\": {\n    \"KAGI_API_KEY\": \"{{KAGI_API_KEY}}\",\n    \"KAGI_SUMMARIZER_ENGINE\": \"{{KAGI_SUMMARIZER_ENGINE}}\"\n  }\n}\n"
    },
    {
      "name": "Smithery Installation",
      "prerequisites": [
        "Node.js"
      ],
      "content": "{\n  \"command\": \"npx\",\n  \"args\": [\"-y\", \"@smithery/cli\", \"install\", \"kagimcp\", \"--client\", \"claude\"]\n}\n"
    },
    {
      "name": "Local Development",
      "content": "{\n  \"command\": \"uv\",\n  \"args\": [\"--directory\", \"{{KAGI_PATH}}\", \"run\", \"kagimcp\"],\n  \"env\": {\n    \"KAGI_API_KEY\": \"{{KAGI_API_KEY}}\",\n    \"KAGI_SUMMARIZER_ENGINE\": \"{{KAGI_SUMMARIZER_ENGINE}}\"\n  }\n}\n",
      "parameters": [
        {
          "name": "Kagi Path",
          "key": "KAGI_PATH",
          "placeholder": "/path/to/kagimcp",
          "optional": true
        }
      ]
    }
  ],
  "parameters": [
    {
      "name": "Kagi API Key",
      "key": "KAGI_API_KEY",
      "placeholder": "your_kagi_api_key_here"
    },
    {
      "name": "Kagi Summarizer Engine",
      "key": "KAGI_SUMMARIZER_ENGINE",
      "placeholder": "cecil",
      "optional": true
    }
  ],
  "type": "mcp",
  "version": "1.0.0",
  "updatedAt": "2026-08-31T00:00:00.000Z"
}
