{
  "id": "esignatures",
  "name": "eSignatures",
  "description": "Manages digital contract workflows including creation, sending, and template management for electronic signatures through the eSignatures platform.",
  "author": "esignaturescom",
  "url": "https://github.com/esignaturescom/mcp-server-esignatures",
  "tags": [
    "digital-signatures",
    "contracts",
    "document-management",
    "templates",
    "collaboration"
  ],
  "content": [
    {
      "name": "UVX",
      "prerequisites": [
        "Python",
        "uv"
      ],
      "content": "{\n  \"command\": \"uvx\",\n  \"args\": [\"mcp-server-esignatures\"],\n  \"env\": {\n    \"ESIGNATURES_SECRET_TOKEN\": \"{{ESIGNATURES_SECRET_TOKEN}}\"\n  }\n}\n"
    },
    {
      "name": "UV Development",
      "prerequisites": [
        "Python",
        "uv"
      ],
      "content": "{\n  \"command\": \"uv\",\n  \"args\": [\n    \"--directory\",\n    \"{{ESIGNATURES_PATH}}\",\n    \"run\",\n    \"mcp-server-esignatures\"\n  ],\n  \"env\": {\n    \"ESIGNATURES_SECRET_TOKEN\": \"{{ESIGNATURES_SECRET_TOKEN}}\"\n  }\n}\n",
      "parameters": [
        {
          "name": "eSignatures Path",
          "key": "ESIGNATURES_PATH",
          "placeholder": "/path/to/mcp-server-esignatures",
          "optional": true
        }
      ]
    }
  ],
  "parameters": [
    {
      "name": "eSignatures Secret Token",
      "key": "ESIGNATURES_SECRET_TOKEN",
      "placeholder": "your_esignatures_api_secret_token"
    }
  ],
  "type": "mcp",
  "version": "1.0.0",
  "updatedAt": "2026-08-31T00:00:00.000Z"
}
