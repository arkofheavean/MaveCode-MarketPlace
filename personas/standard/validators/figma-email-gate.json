{
  "schemaVersion": 3,
  "kind": "figma-email-html-gate",
  "description": "Package-owned Standard completion-gate rules for Figma/email output. Every rule (activation, parameters, issue code, and message) is Standard persona data executed by the generic extension rule engine.",
  "rules": [
    {
      "id": "standard-unsupported-tags",
      "type": "forbidden-tag",
      "code": "UNSUPPORTED_TAG",
      "message": "Unsupported email HTML tags found:",
      "tags": ["script", "iframe", "embed", "object", "form", "input", "button"]
    },
    {
      "id": "standard-unsupported-css",
      "type": "forbidden-css-feature",
      "code": "UNSUPPORTED_CSS",
      "message": "Unsupported email CSS found:",
      "features": [
        { "label": "display:flex", "pattern": "display\\s*:\\s*flex" },
        { "label": "display:grid", "pattern": "display\\s*:\\s*grid" },
        { "label": "gap", "pattern": "(?:^|;)\\s*gap\\s*:" },
        { "label": "position:absolute", "pattern": "position\\s*:\\s*absolute" },
        { "label": "position:fixed", "pattern": "position\\s*:\\s*fixed" },
        { "label": "@import", "pattern": "@import\\b" },
        { "label": "CSS variables", "pattern": "(?:var\\(|--[A-Za-z0-9_-]+\\s*:)" },
        { "label": "pseudo-elements", "pattern": "::(?:before|after)\\b" },
        { "label": "keyword font-weight", "pattern": "font-weight\\s*:\\s*(?:bold|normal|lighter|bolder)" }
      ]
    },
    {
      "id": "standard-td-alignment-attributes",
      "type": "required-tag-attributes",
      "code": "TD_ALIGNMENT_ATTRIBUTES",
      "message": "Every td must explicitly include both align and valign attributes.",
      "tag": "td",
      "attributePatterns": ["\\salign\\s*=", "\\svalign\\s*="]
    },
    {
      "id": "standard-table-presentation-role",
      "type": "required-tag-attributes",
      "code": "TABLE_PRESENTATION_ROLE",
      "message": "Layout tables must include role=\"presentation\".",
      "tag": "table",
      "attributePatterns": ["\\srole\\s*=\\s*[\"']presentation[\"']"]
    },
    {
      "id": "standard-image-alt-required",
      "type": "required-tag-attributes",
      "code": "IMAGE_ALT_MISSING",
      "message": "Every img element must include an alt attribute.",
      "tag": "img",
      "attributePatterns": ["\\salt\\s*="]
    },
    {
      "id": "standard-image-height-attribute",
      "type": "forbidden-css-pattern",
      "code": "IMAGE_HEIGHT_ATTRIBUTE",
      "message": "An img element has a prohibited height attribute.",
      "pattern": "<img\\b[^>]*\\sheight\\s*="
    },
    {
      "id": "standard-image-height-style",
      "type": "forbidden-inline-style-property",
      "code": "IMAGE_HEIGHT_STYLE",
      "message": "An img element has prohibited inline height CSS.",
      "tag": "img",
      "propertyPattern": "(?:^|;)\\s*height\\s*:"
    },
    {
      "id": "standard-no-colspan",
      "type": "forbidden-css-pattern",
      "code": "COLSPAN",
      "message": "Generated email markup must not use colspan.",
      "pattern": "\\scolspan\\s*="
    },
    {
      "id": "standard-no-empty-generic-comments",
      "type": "forbidden-css-pattern",
      "code": "GENERIC_EMPTY_COMMENT",
      "message": "Final output must not retain empty generic block comments.",
      "pattern": "<!--\\s*Body Block \\d+ BELOW as table\\s*-->\\s*<!--\\s*Body Block \\d+ BELOW as table ENDS\\s*-->"
    },
    {
      "id": "standard-span-font-family",
      "type": "forbidden-inline-style-property",
      "code": "SPAN_FONT_FAMILY",
      "message": "Spans must not carry font-family; parent text cells own it.",
      "tag": "span",
      "propertyPattern": "\\bfont-family\\s*:"
    },
    {
      "id": "standard-span-typography",
      "type": "forbidden-inline-style-property",
      "code": "SPAN_TYPOGRAPHY",
      "message": "Spans should not carry font-size or line-height unless intentionally different from the parent cell.",
      "tag": "span",
      "propertyPattern": "\\b(?:font-size|line-height)\\s*:"
    },
    {
      "id": "standard-vml-word-namespace",
      "type": "conditional-required-pattern",
      "code": "VML_WORD_NAMESPACE",
      "message": "VML w:anchorlock requires the Word namespace on html.",
      "whenPattern": "\\bw:anchorlock\\b",
      "requiredPatterns": ["xmlns:w\\s*=\\s*[\"']urn:schemas-microsoft-com:office:word[\"']"]
    },
    {
      "id": "standard-dark-mode-meta",
      "type": "conditional-required-pattern",
      "code": "DARK_MODE_META",
      "message": "Color-scheme CSS requires matching dark-mode meta tags.",
      "whenPattern": "color-scheme\\s*:\\s*light dark",
      "requiredPatterns": [
        "<meta\\b[^>]*name\\s*=\\s*[\"']color-scheme[\"'][^>]*content\\s*=\\s*[\"']light dark[\"'][^>]*>",
        "<meta\\b[^>]*name\\s*=\\s*[\"']supported-color-schemes[\"'][^>]*content\\s*=\\s*[\"']light dark[\"'][^>]*>"
      ]
    },
    {
      "id": "standard-content-td-height",
      "type": "content-cell-height-policy",
      "code": "CONTENT_TD_HEIGHT",
      "message": "A content td has height; only an actual CTA button cell or dedicated empty spacer cell may have height.",
      "heightClassPattern": "\\bem_h\\d+\\b"
    },
    {
      "id": "standard-text-only-td-width",
      "type": "text-only-cell-width-policy",
      "code": "TEXT_ONLY_TD_WIDTH",
      "message": "A paragraph/body-text-only td has width; its parent table or structural column must control width."
    },
    {
      "id": "standard-fixed-mobile-width",
      "type": "forbidden-css-pattern",
      "code": "STANDARD_FIXED_MOBILE_WIDTH",
      "message": "Standard mobile em_main_table rules must remain width:100% !important, not fixed pixels.",
      "pattern": "\\.em_main_table\\s*{[^}]*width\\s*:\\s*(?:375px|320px)\\s*!important"
    },
    {
      "id": "standard-dark-mode-css",
      "type": "required-css-signature",
      "code": "STANDARD_DARK_MODE_CSS",
      "message": "Standard output is missing required color-scheme declarations or approved dark-mode CSS.",
      "patterns": [
        "color-scheme\\s*:\\s*light dark",
        "supported-color-schemes\\s*:\\s*light dark",
        "<meta\\b[^>]*name\\s*=\\s*[\"']color-scheme[\"'][^>]*content\\s*=\\s*[\"']light dark[\"'][^>]*>",
        "<meta\\b[^>]*name\\s*=\\s*[\"']supported-color-schemes[\"'][^>]*content\\s*=\\s*[\"']light dark[\"'][^>]*>",
        "@media[^{}]*prefers-color-scheme\\s*:\\s*dark",
        "\\.em_dm_txt_white\\b",
        "\\.em_dm_txt_black\\b",
        "\\.em_darkbg\\b",
        "\\.em_lightbg\\b"
      ]
    },
    {
      "id": "standard-dark-mode-classes",
      "type": "required-class-mapping",
      "code": "STANDARD_DARK_MODE_CLASSES",
      "message": "Standard output has qualifying surfaces, text, links, paragraphs, or CTA elements without approved mapped dark-mode utility classes.",
      "mappings": [
        {
          "target": "surface",
          "colorPattern": "#(?:fff|ffffff)\\b",
          "requiredClass": "em_darkbg"
        },
        {
          "target": "surface",
          "colorPattern": "#(?:000|000000|191919|3c3c3c)\\b",
          "requiredClass": "em_lightbg"
        },
        {
          "target": "text",
          "colorPattern": "#(?:000|000000|191919|3c3c3c)\\b",
          "requiredClass": "em_dm_txt_white"
        },
        {
          "target": "text",
          "colorPattern": "#(?:fff|ffffff|f5f5f5|f7f7f7|fafafa)\\b",
          "requiredClass": "em_dm_txt_black"
        }
      ]
    },
    {
      "id": "standard-reference-sample-leakage",
      "type": "content-marker-leakage",
      "code": "REFERENCE_SAMPLE_CONTENT",
      "message": "Output contains persona-reference sample content not found in the task's primary reference:",
      "markers": ["Prodigy Education", "get.prodigygame.com", "ProdigyGame"]
    }
  ]
}
